+    /// BATON: handle an insert or replace during composition. `true` if
+    /// handled.
+    ///
+    /// **The model.** `composing` is the document the input method believes in.
+    /// It remembers everything it inserted, cumulatively, and asks for
+    /// replacements in those coordinates -- so we have to hold the same
+    /// document. `committed_utf16` marks how much of it already went to the
+    /// app, and the remaining tail is the preedit. The only events that leave
+    /// here are standard `Preedit` / `Commit`.
+    fn handle_composing_insert(&self, string: &str, repl: NSRange) -> bool {
+        let has_repl = repl.location != NSNotFound as NSUInteger;
+        let mut doc = self.ivars().composing.borrow_mut();
+
+        if has_repl {
+            let units: Vec<u16> = doc.encode_utf16().collect();
+            let start = (repl.location as usize).min(units.len());
+            let end = start.saturating_add(repl.length).min(units.len());
+            // A request to replace text we already committed cannot be
+            // honoured. In practice the input method only touches the last
+            // syllable, so this does not trigger.
+            if start < self.ivars().committed_utf16.get() {
+                tracing::warn!(
+                    "BATON: asked to replace committed text at {start}; ignoring"
+                );
+                return false;
+            }
+            let mut next = String::from_utf16_lossy(&units[..start]);
+            next.push_str(string);
+            next.push_str(&String::from_utf16_lossy(&units[end..]));
+            *doc = next;
+        } else {
+            let len16 = doc.encode_utf16().count();
+            let committed = self.ivars().committed_utf16.get();
+            let pending = len16 > committed;
+
+            // **Nothing in flight and nothing composable: touch nothing.**
+            // Latin, digits and punctuation take exactly the upstream path, so
+            // there is no lag and `KeyboardInput` still arrives.
+            if !pending && !is_composing_script(string) {
+                return false;
+            }
+
+            // Not a replacement, so the previous composition is final.
+            if pending {
+                let units: Vec<u16> = doc.encode_utf16().collect();
+                let tail = String::from_utf16_lossy(&units[committed..]);
+                self.queue_event(WindowEvent::Ime(Ime::Preedit(String::new(), None)));
+                self.queue_event(WindowEvent::Ime(Ime::Commit(tail)));
+                self.ivars().committed_utf16.set(len16);
+            }
+
+            // Keep the document, but reset the session if it grows large so
+            // offsets stay bounded.
+            if doc.encode_utf16().count() > 4096 {
+                doc.clear();
+                self.ivars().committed_utf16.set(0);
+            }
+
+            if !is_composing_script(string) {
+                // A space, letter or punctuation mark **immediately after** a
+                // composition. The state transition suppresses the raw key
+                // (`had_ime_input`), so send this character as a `Commit`; it
+                // then arrives exactly once.
+                doc.push_str(string);
+                self.ivars().committed_utf16.set(doc.encode_utf16().count());
+                self.ivars().ime_state.set(ImeState::Committed);
+                self.queue_event(WindowEvent::Ime(Ime::Commit(string.to_owned())));
+                return true;
+            }
+            doc.push_str(string);
+        }
+
+        let committed = self.ivars().committed_utf16.get();
+        let units: Vec<u16> = doc.encode_utf16().collect();
+        let preedit = String::from_utf16_lossy(&units[committed.min(units.len())..]);
+        tracing::warn!(
+            "BATON insert {:?} repl=({}, {}) -> doc={:?} committed={} preedit={:?}",
+            string,
+            repl.location as i64,
+            repl.length,
+            doc.clone(),
+            committed,
+            preedit
+        );
+        drop(doc);
+
+        if self.ivars().ime_state.get() == ImeState::Disabled {
+            *self.ivars().input_source.borrow_mut() = self.current_input_source();
+            self.queue_event(WindowEvent::Ime(Ime::Enabled));
+        }
+        self.ivars().ime_state.set(ImeState::Preedit);
+        let caret = preedit.len();
+        self.queue_event(WindowEvent::Ime(Ime::Preedit(preedit, Some((caret, caret)))));
+        true
+    }
