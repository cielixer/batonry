+/// BATON: can the input method still come back and replace this text?
+///
+/// Only Hangul jamo and syllables are held. Latin letters, digits and
+/// punctuation are never revised by the Korean input method, so they go out
+/// immediately -- **this is why typing English has no one-character lag.**
+fn is_composing_script(s: &str) -> bool {
+    !s.is_empty()
+        && s.chars().all(|c| {
+            matches!(c as u32,
+                0x1100..=0x11FF |   // Hangul Jamo
+                0x3130..=0x318F |   // Compatibility Jamo
+                0xA960..=0xA97F |   // Jamo Extended-A
+                0xAC00..=0xD7A3 |   // Syllables
+                0xD7B0..=0xD7FF     // Jamo Extended-B
+            )
+        })
+}
 
