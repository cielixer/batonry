+#[allow(dead_code)]
+/// BATON: one shaping call for a run of same-style ASCII in the same row.
+struct GlyphRun {
+    line: i32,
+    /// The column this run expects next. A gap flushes the run.
+    next_col: f32,
+    /// Left edge of the run, on a cell boundary.
+    x: f32,
+    /// Vertical centre of the cell; matches the per-cell path.
+    y: f32,
+    color: Color,
+    font: iced::Font,
+    text: String,
+}
+
+fn flush_run(
+    frame: &mut iced::widget::canvas::Frame,
+    run: Option<GlyphRun>,
+    font_size: f32,
+    font_scale_factor: f32,
+) {
+    let Some(run) = run else { return };
+    if run.text.trim().is_empty() {
+        // A run of only spaces has nothing to draw; the background was
+        // already painted by the run-length pass.
+        return;
+    }
+    crate::metrics::TEXT_OPS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    frame.fill_text(Text {
+        content: run.text,
+        position: Point::new(run.x, run.y),
+        font: run.font,
+        size: iced_core::Pixels(font_size),
+        color: run.color,
+        align_x: Alignment::Left,
+        align_y: Vertical::Center,
+        shaping: Shaping::Advanced,
+        line_height: LineHeight::Relative(font_scale_factor),
+        ..Default::default()
+    });
+}
