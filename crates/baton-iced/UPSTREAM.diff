Our delta on top of the `iced` 0.14.0 hardcopy.
=======================================================================

**No source file is changed.** The only edit is one dependency in Cargo.toml
(iced_winit -> baton-iced-winit), plus removing examples/tests/benches and their manifest entries to
keep the tree small.

`iced`'s code says `use iced_winit::...` and still does. A
renamed dependency (`package = "..."`) swaps the package behind that name, so
the source needs no edits and stays diffable against upstream.

To regenerate:

    curl -sL -o c.crate https://static.crates.io/crates/iced/iced-0.14.0.crate
    tar xzf c.crate
    diff -u iced-0.14.0/Cargo.toml crates/baton-iced/Cargo.toml

=======================================================================
--- iced-0.14.0/Cargo.toml
+++ crates/baton-iced/Cargo.toml
@@ -12,7 +12,7 @@
 [package]
 edition = "2024"
 rust-version = "1.88"
-name = "iced"
+name = "baton-iced"
 version = "0.14.0"
 authors = ["Héctor Ramón Jiménez <hector@hecrj.dev>"]
 build = false
@@ -130,11 +130,7 @@
 name = "iced"
 path = "src/lib.rs"
 
-[[bench]]
-name = "wgpu"
-path = "benches/wgpu.rs"
-harness = false
-required-features = ["canvas"]
+["canvas"]
 
 [dependencies.iced_core]
 version = "0.14.0"
@@ -166,8 +162,10 @@
 [dependencies.iced_widget]
 version = "0.14.0"
 
+# Renamed dependency: the code says `use iced_winit::...` and is untouched.
 [dependencies.iced_winit]
-version = "0.14.0"
+package = "baton-iced-winit"
+path = "../baton-iced-winit"
 default-features = false
 
 [dependencies.image]
@@ -204,6 +202,10 @@
 useless_conversion = "deny"
 
 [lints.rust]
+# BATON: upstream calls futures::try_next, which a newer futures
+# deprecated. As a path dependency that warning is now ours to see on
+# every build. Silence it here rather than diverge from upstream source.
+deprecated = "allow"
 missing_docs = "deny"
 unsafe_code = "deny"
 unused_results = "deny"
