Our delta on top of the `iced_winit` 0.14.0 hardcopy.
=======================================================================

**No source file is changed.** The only edit is one dependency in Cargo.toml
(winit -> baton-winit), plus removing examples/tests/benches and their manifest entries to
keep the tree small.

`iced_winit`'s code says `use winit::...` and still does. A
renamed dependency (`package = "..."`) swaps the package behind that name, so
the source needs no edits and stays diffable against upstream.

To regenerate:

    curl -sL -o c.crate https://static.crates.io/crates/iced_winit/iced_winit-0.14.0.crate
    tar xzf c.crate
    diff -u iced_winit-0.14.0/Cargo.toml crates/baton-iced-winit/Cargo.toml

=======================================================================
--- iced_winit-0.14.0/Cargo.toml
+++ crates/baton-iced-winit/Cargo.toml
@@ -11,7 +11,7 @@
 
 [package]
 edition = "2024"
-name = "iced_winit"
+name = "baton-iced-winit"
 version = "0.14.0"
 authors = ["Héctor Ramón Jiménez <hector@hecrj.dev>"]
 build = false
@@ -88,8 +88,11 @@
 version = "0.5"
 default-features = false
 
+# Renamed dependency: the code says `use winit::...` and is untouched, but the
+# package behind that name is our fork. See crates/baton-winit/NOTICE.md.
 [dependencies.winit]
-version = "0.30"
+package = "baton-winit"
+path = "../baton-winit"
 features = ["rwh_06"]
 default-features = false
 
@@ -128,6 +131,10 @@
 useless_conversion = "deny"
 
 [lints.rust]
+# BATON: upstream calls futures::try_next, which a newer futures
+# deprecated. As a path dependency that warning is now ours to see on
+# every build. Silence it here rather than diverge from upstream source.
+deprecated = "allow"
 missing_docs = "deny"
 unsafe_code = "deny"
 unused_results = "deny"
